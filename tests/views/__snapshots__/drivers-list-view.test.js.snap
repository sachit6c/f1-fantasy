// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DriversListView > snapshot > driver card structure matches snapshot 1`] = `"<div class="driver-card" style="--team-color: #3671C6;"><div class="driver-card__photo-area"><div class="driver-card__code-bg">VER</div><img src="data/images/drivers/max_verstappen.jpg" alt="Max Verstappen" class="driver-card__photo"></div><div class="driver-card__stripe"></div><div class="driver-card__info"><h2 class="driver-card__name">Max Verstappen</h2><div class="driver-card__meta-row"><span class="driver-card__team-name">Red Bull Racing</span><span class="driver-card__meta-sep">·</span><span class="driver-card__nat">Dutch</span><span class="driver-card__code-chip">VER</span></div><div class="driver-card__stats"><div class="driver-card__stat"><span class="driver-card__stat-val empty">—</span><span class="driver-card__stat-key">POS</span></div><div class="driver-card__stat"><span class="driver-card__stat-val empty">—</span><span class="driver-card__stat-key">PTS</span></div><div class="driver-card__stat"><span class="driver-card__stat-val empty">—</span><span class="driver-card__stat-key">WINS</span></div></div></div></div>"`;

exports[`DriversListView > snapshot > empty state matches snapshot 1`] = `
"<div class="empty-state">
      <div class="empty-state-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path>
        </svg></div>
      <h3>No drivers found</h3>
      <p>Driver data for this season hasn't been loaded yet.</p>
    </div>"
`;
